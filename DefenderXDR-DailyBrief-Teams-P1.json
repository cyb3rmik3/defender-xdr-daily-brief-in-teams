{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "DefenderXDR-DailyBrief-Teams",
      "metadata": {
        "description": "Name of the Logic App workflow."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for deployment."
      }
    },
    "teamsGroupId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Teams Group (Team) ID."
      }
    },
    "teamsChannelId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Teams Channel ID."
      }
    },
    "teamsConnectionName": {
      "type": "string",
      "defaultValue": "teams-DefenderBriefingConn",
      "metadata": {
        "description": "Name of the Teams API connection resource."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('teamsConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[parameters('teamsConnectionName')]",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/teams')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('teamsConnectionName'))]"
      ],
      "tags": {
        "displayName": "Defender XDR Daily Brief – Teams"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "teamsGroupId": {
              "defaultValue": "[parameters('teamsGroupId')]",
              "type": "String"
            },
            "teamsChannelId": {
              "defaultValue": "[parameters('teamsChannelId')]",
              "type": "String"
            },
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Daily_6AM_UTC": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "timeZone": "UTC",
                "schedule": {
                  "hours": [
                    6
                  ],
                  "minutes": [
                    0
                  ]
                }
              }
            }
          },
          "actions": {
            "Init_KQL_HighAlerts": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  {
                    "name": "kql_high_alerts",
                    "type": "string",
                    "value": "AlertInfo | where Timestamp >= ago(24h) | where Severity == \"High\" | summarize Alerts = count()"
                  }
                ]
              }
            },
            "Init_KQL_AIRRemediated": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  {
                    "name": "kql_air_remediated",
                    "type": "string",
                    "value": "let AlertsLast24h = AlertInfo | where Timestamp >= ago(24h) | summarize TotalAlertsLast24h = dcount(AlertId); let AIRRemediatedAlerts = AlertEvidence | where Timestamp >= ago(24h) | extend RemediationStatusNorm = tolower(tostring(column_ifexists(\"RemediationStatus\", \"\"))) | extend RemediationSourceNorm = tolower(tostring(column_ifexists(\"RemediationSource\", column_ifexists(\"RemediationType\", \"\")))) | where RemediationStatusNorm has \"remediat\" | where isempty(RemediationSourceNorm) or RemediationSourceNorm has_any (\"automatic\", \"auto\", \"air\", \"investigation\") | summarize RemediatedByAIRLast24h = dcount(AlertId); AlertsLast24h | extend JoinKey = 1 | join kind=inner (AIRRemediatedAlerts | extend JoinKey = 1) on JoinKey | project RemediatedByAIRLast24h"
                  }
                ]
              }
            },
            "Init_KQL_NewDiscoveredApps": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  {
                    "name": "kql_new_discovered_apps",
                    "type": "string",
                    "value": "CloudAppEvents | where Timestamp > ago(30d) | summarize FirstSeenInWindow = min(Timestamp) by ApplicationId | where FirstSeenInWindow > ago(24h) | summarize UniqueApps = dcount(ApplicationId)"
                  }
                ]
              }
            },
            "Init_KQL_PrivilegedIdentities": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  {
                    "name": "kql_privileged_identities",
                    "type": "string",
                    "value": "IdentityInfo | extend SensitiveUser = Tags has 'Sensitive' | extend GlobalAdministrator = AssignedRoles has 'Global Administrator' | extend SecurityAdministrator = set_has_element(AssignedRoles, 'Security Administrator') | summarize arg_max(Timestamp, SensitiveUser, GlobalAdministrator, SecurityAdministrator) by AccountObjectId | where Timestamp > ago(14d) | summarize     SensitiveUsers = dcountif(AccountObjectId, SensitiveUser),     GlobalAdministrators = dcountif(AccountObjectId, GlobalAdministrator),     SecurityAdministrators = dcountif(AccountObjectId, SecurityAdministrator)"
                  }
                ]
              }
            },
            "GH_HighAlerts": {
              "type": "Http",
              "runAfter": {
                "Init_KQL_HighAlerts": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
                "headers": {
                  "Content-Type": "application/json; charset=utf-8"
                },
                "body": {
                  "Query": "@variables('kql_high_alerts')"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Parse_HighAlerts": {
              "type": "ParseJson",
              "runAfter": {
                "GH_HighAlerts": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "content": "@body('GH_HighAlerts')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "Get_HighAlerts": {
              "type": "Compose",
              "runAfter": {
                "Parse_HighAlerts": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(first(body('Parse_HighAlerts')?['results'])?['Alerts'], 0)"
            },
            "GH_AIRRemediated": {
              "type": "Http",
              "runAfter": {
                "Init_KQL_AIRRemediated": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
                "headers": {
                  "Content-Type": "application/json; charset=utf-8"
                },
                "body": {
                  "Query": "@variables('kql_air_remediated')"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Parse_AIRRemediated": {
              "type": "ParseJson",
              "runAfter": {
                "GH_AIRRemediated": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "content": "@body('GH_AIRRemediated')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "Get_AIRRemediated": {
              "type": "Compose",
              "runAfter": {
                "Parse_AIRRemediated": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(first(body('Parse_AIRRemediated')?['results'])?['RemediatedByAIRLast24h'], 0)"
            },
            "GH_NewDiscoveredApps": {
              "type": "Http",
              "runAfter": {
                "Init_KQL_NewDiscoveredApps": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
                "headers": {
                  "Content-Type": "application/json; charset=utf-8"
                },
                "body": {
                  "Query": "@variables('kql_new_discovered_apps')"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Parse_NewDiscoveredApps": {
              "type": "ParseJson",
              "runAfter": {
                "GH_NewDiscoveredApps": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "content": "@body('GH_NewDiscoveredApps')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "Get_NewDiscoveredApps": {
              "type": "Compose",
              "runAfter": {
                "Parse_NewDiscoveredApps": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(first(body('Parse_NewDiscoveredApps')?['results'])?['UniqueApps'], 0)"
            },
            "Compose_AdaptiveCard": {
              "runAfter": {
                "Get_HighAlerts": [
                  "Succeeded"
                ],
                "Get_AIRRemediated": [
                  "Succeeded"
                ],
                "Get_NewDiscoveredApps": [
                  "Succeeded"
                ],
                "Get_SensitiveUsers": [
                  "Succeeded"
                ],
                "Get_GlobalAdmins": [
                  "Succeeded"
                ],
                "Get_SecurityAdmins": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.5",
                "body": [
                  {
                    "type": "TextBlock",
                    "text": "🚨 Microsoft Defender XDR Brief",
                    "weight": "Bolder",
                    "size": "Large",
                    "color": "Accent",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "text": "🌅 Morning highlights from Microsoft Defender XDR – review each security workload to ensure full visibility.",
                    "isSubtle": true,
                    "spacing": "None",
                    "wrap": true
                  },
                  {
                    "type": "Container",
                    "style": "emphasis",
                    "spacing": "Medium",
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "🚨 Alert Triage & Automation (AIR)",
                        "weight": "Bolder",
                        "color": "Accent",
                        "wrap": true
                      },
                      {
                        "type": "Container",
                        "spacing": "Medium",
                        "items": [
                          {
                            "type": "ColumnSet",
                            "columns": [
                              {
                                "type": "Column",
                                "width": "stretch",
                                "items": [
                                  {
                                    "type": "TextBlock",
                                    "text": "@{outputs('Get_HighAlerts')}",
                                    "size": "Large",
                                    "weight": "Bolder",
                                    "color": "Accent",
                                    "horizontalAlignment": "Center"
                                  },
                                  {
                                    "type": "TextBlock",
                                    "text": "High severity alerts",
                                    "isSubtle": true,
                                    "horizontalAlignment": "Center",
                                    "wrap": true
                                  }
                                ]
                              },
                              {
                                "type": "Column",
                                "width": "stretch",
                                "items": [
                                  {
                                    "type": "TextBlock",
                                    "text": "@{outputs('Get_AIRRemediated')}",
                                    "size": "Large",
                                    "weight": "Bolder",
                                    "color": "Accent",
                                    "horizontalAlignment": "Center"
                                  },
                                  {
                                    "type": "TextBlock",
                                    "text": "AIR Remediated",
                                    "isSubtle": true,
                                    "horizontalAlignment": "Center",
                                    "wrap": true
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "ColumnSet",
                        "spacing": "Medium",
                        "columns": [
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "ActionSet",
                                "actions": [
                                  {
                                    "type": "Action.OpenUrl",
                                    "title": "🔎 Open Alert Queue",
                                    "url": "https://security.microsoft.com/incidents"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "ActionSet",
                                "actions": [
                                  {
                                    "type": "Action.OpenUrl",
                                    "title": "🛡️ Open Defender XDR",
                                    "url": "https://security.microsoft.com"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "style": "emphasis",
                    "spacing": "Medium",
                    "separator": true,
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "☁️ Cloud App Risk",
                        "weight": "Bolder",
                        "color": "Accent",
                        "wrap": true
                      },
                      {
                        "type": "ColumnSet",
                        "spacing": "Medium",
                        "columns": [
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "TextBlock",
                                "text": "@{outputs('Get_NewDiscoveredApps')}",
                                "size": "Large",
                                "weight": "Bolder",
                                "color": "Accent",
                                "horizontalAlignment": "Center"
                              },
                              {
                                "type": "TextBlock",
                                "text": "New discovered apps",
                                "isSubtle": true,
                                "horizontalAlignment": "Center",
                                "wrap": true
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "ColumnSet",
                        "spacing": "Small",
                        "columns": [
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "ActionSet",
                                "actions": [
                                  {
                                    "type": "Action.OpenUrl",
                                    "title": "🌐 High-risk apps",
                                    "url": "https://security.microsoft.com/applications?tab=saas&tag=eq(None%2C)&score=eq(i%3A0%2Ci%3A3)"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "ActionSet",
                                "actions": [
                                  {
                                    "type": "Action.OpenUrl",
                                    "title": "🌐 High-traffic apps",
                                    "url": "https://security.microsoft.com/applications?tab=saas&tag=eq(None%2C)&traffic=gt(i%3A1024)"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Container",
                    "style": "emphasis",
                    "spacing": "Medium",
                    "separator": true,
                    "items": [
                      {
                        "type": "TextBlock",
                        "text": "🔑 Identity Posture",
                        "weight": "Bolder",
                        "color": "Accent",
                        "wrap": true
                      },
                      {
                        "type": "ColumnSet",
                        "spacing": "Medium",
                        "columns": [
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "TextBlock",
                                "text": "@{outputs('Get_GlobalAdmins')}",
                                "size": "Large",
                                "weight": "Bolder",
                                "color": "Accent",
                                "horizontalAlignment": "Center"
                              },
                              {
                                "type": "TextBlock",
                                "text": "Global Administrators",
                                "isSubtle": true,
                                "horizontalAlignment": "Center",
                                "wrap": true
                              }
                            ]
                          },
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "TextBlock",
                                "text": "@{outputs('Get_SecurityAdmins')}",
                                "size": "Large",
                                "weight": "Bolder",
                                "color": "Accent",
                                "horizontalAlignment": "Center"
                              },
                              {
                                "type": "TextBlock",
                                "text": "Security Administrators",
                                "isSubtle": true,
                                "horizontalAlignment": "Center",
                                "wrap": true
                              }
                            ]
                          },
                          {
                            "type": "Column",
                            "width": "stretch",
                            "items": [
                              {
                                "type": "TextBlock",
                                "text": "@{outputs('Get_SensitiveUsers')}",
                                "size": "Large",
                                "weight": "Bolder",
                                "color": "Accent",
                                "horizontalAlignment": "Center"
                              },
                              {
                                "type": "TextBlock",
                                "text": "Sensitive Users",
                                "isSubtle": true,
                                "horizontalAlignment": "Center",
                                "wrap": true
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "ActionSet",
                        "spacing": "Small",
                        "actions": [
                          {
                            "type": "Action.OpenUrl",
                            "title": "🫆 Review Identity Posture Insights",
                            "url": "https://security.microsoft.com/identities/dashboard"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            "Post_AdaptiveCard_To_Teams": {
              "runAfter": {
                "Compose_AdaptiveCard": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['teams-DefenderBriefingConn']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "recipient": {
                    "groupId": "@parameters('teamsGroupId')",
                    "channelId": "@parameters('teamsChannelId')"
                  },
                  "messageBody": "@{outputs('Compose_AdaptiveCard')}"
                },
                "path": "/v1.0/teams/conversation/adaptivecard/poster/Flow bot/location/@{encodeURIComponent('Channel')}"
              }
            },
            "GH_PrivilegedIdentities": {
              "type": "Http",
              "runAfter": {
                "Init_KQL_PrivilegedIdentities": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
                "headers": {
                  "Content-Type": "application/json; charset=utf-8"
                },
                "body": {
                  "Query": "@variables('kql_privileged_identities')"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Parse_PrivilegedIdentities": {
              "type": "ParseJson",
              "runAfter": {
                "GH_PrivilegedIdentities": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "content": "@body('GH_PrivilegedIdentities')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "Get_SensitiveUsers": {
              "type": "Compose",
              "runAfter": {
                "Parse_PrivilegedIdentities": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(first(body('Parse_PrivilegedIdentities')?['results'])?['SensitiveUsers'], 0)"
            },
            "Get_GlobalAdmins": {
              "type": "Compose",
              "runAfter": {
                "Parse_PrivilegedIdentities": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(first(body('Parse_PrivilegedIdentities')?['results'])?['GlobalAdministrators'], 0)"
            },
            "Get_SecurityAdmins": {
              "type": "Compose",
              "runAfter": {
                "Parse_PrivilegedIdentities": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(first(body('Parse_PrivilegedIdentities')?['results'])?['SecurityAdministrators'], 0)"
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "teams-DefenderBriefingConn": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/teams')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('teamsConnectionName'))]",
                "connectionName": "[parameters('teamsConnectionName')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('workflowName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'Full').identity.principalId]"
    },
    "postDeploymentNote": {
      "type": "string",
      "value": "Grant the Managed Identity the 'ThreatHunting.Read.All' application permission on Microsoft Graph in Entra ID."
    }
  }
}